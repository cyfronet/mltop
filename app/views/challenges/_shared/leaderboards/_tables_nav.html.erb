<%# locals: items - array of [title, anchor] %>
<nav aria-label="Tables" class="hidden lg:block w-56 shrink-0">
  <div class="sticky top-4 max-h-[calc(100vh-2rem)] overflow-y-auto border border-zinc-300 dark:border-zinc-600 bg-white dark:bg-zinc-700 text-sm shadow-xs">
    <details open class="group">
      <summary class="flex items-center justify-between cursor-pointer list-none select-none px-3 py-2 font-semibold text-zinc-900 dark:text-zinc-200">
        Tables
        <svg class="h-4 w-4 transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
        </svg>
      </summary>
      <ul class="border-t border-zinc-300 dark:border-zinc-600 py-1">
        <% items.each do |title, anchor| %>
          <li>
            <a href="#<%= anchor %>" class="block px-3 py-1.5 text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-600 truncate" title="<%= title %>">
              <%= title %>
            </a>
          </li>
        <% end %>
      </ul>
    </details>
  </div>
</nav>
